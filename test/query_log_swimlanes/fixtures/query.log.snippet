MATCH (acg:AccessGroup)-[:HAS_TYPE]->(al:ALAttachmentType) 
WHERE id(acg)=toInteger($accessGroupId) 
WITH n, collect(al.Type) as alTypes, CASE WHEN acg.OwnerEntity IS NULL THEN $customerSpaceId ELSE 'CUS_' + acg.OwnerEntity END as customerSpaceId 
MATCH (ri:RevisionItem) 
WHERE ri.ItemId = n.ItemId 
WITH n, ri, alTypes, customerSpaceId 
CALL (ri) {
	MATCH (ri)<-[:COMPOSED]-(:Revision)-[:COMPOSED]->(a:Attachment) 
	WHERE a.ViewOnlineState = "Online" OR (a.ViewOnlineState = "Default" AND a.ViewFromDate <= timestamp() < a.ViewToDate) 
	RETURN collect(distinct a.ItemId) as attachments 
} 
WITH n, ri, alTypes, customerSpaceId, attachments 
CALL (ri, alTypes, customerSpaceId) {
	MATCH (ri)<-[:ASSOCIATED_TO]-(:RevisionItemCus)<-[:COMPOSED]-(rCus:RevisionCus)<-[:REVISED]-(:ProductCus)<-[:HAS_PRODUCTCUS]-(:CustomerSpace {CustomerSpaceId:customerSpaceId}) 
	MATCH (rCus)-[:COMPOSED]->(a:ALAttachment) 
	WHERE a.ViewOnlineState = "Online" OR (a.ViewOnlineState = "Default" AND a.ViewFromDate <= timestamp() < a.ViewToDate) 
	MATCH (a)-[:CONTAINS_ATTACHMENT_SOLUTION]->(s:ALSolution) 
	WHERE s.AttachmentType IN alTypes
	RETURN collect(distinct a.ItemId) as alattachments 
} 
WITH n, attachments + alattachments as onlineTRs 
OPTIONAL MATCH (a:Attachment)-[:CONTAINS_TRTOC]->(trtoc:TRTocItem) 
WHERE trtoc.ItemId = n.ItemId AND a.ItemId IN onlineTRs OPTIONAL MATCH (a)-[:CONTAINS_TRTOC]->(advctoc:ADVCTocItem) 
WHERE advctoc.ItemId = n.ItemId WITH n, onlineTRs, collect(distinct trtoc.Id) as onlineTRTocs, collect(distinct advctoc.Id) as onlineTRADVCTocs 
WITH n, onlineTRs, onlineTRTocs + onlineTRADVCTocs as onlineTRTocItems OPTIONAL MATCH (n)-[:PARENT_OF*1..]->(trtoc:TRTocItem) 
WHERE NOT trtoc.ItemId IN onlineTRTocItems 
OPTIONAL MATCH (n)-[:PARENT_OF*1..]->(advctoc:ADVCTocItem) 
WHERE NOT advctoc.ItemId IN onlineTRTocItems 
WITH onlineTRs, onlineTRTocItems, collect(advctoc.Id) as onlineTRADVCTocs, collect(trtoc.Id) as onlineTRTocs RETURN onlineTRs, onlineTRTocItems + onlineTRTocs + onlineTRADVCTocs as onlineTRTocItems  - {accessGroupId: '123104893', Id: '801803_SGML_C_EN525113', customerSpaceId: 'CUS_CWA000830'} - runtime=pipelined - {app: 'Java/21.0.8 (Eclipse Adoptium OpenJDK 64-Bit Server VM 21.0.8+9-LTS) neo4j-java/5.28.10 spring-data/3.5.9 spring-data-neo4j/7.5.9'}
